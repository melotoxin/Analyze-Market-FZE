# Copy to .env.local for local dev, and set these in Vercel → Settings →
# Environment Variables for production. Never commit real values.

# Required: without it /api/lead returns 503 and logs the lead to the function log.
# Create a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: defaults to info@amdxb.com
LEAD_TO_EMAIL=info@amdxb.com

# Optional: must be a domain you have verified in Resend.
# Until amdxb.com is verified there, leave the Resend sandbox sender.
LEAD_FROM_EMAIL="AM DXB Website <onboarding@resend.dev>"
