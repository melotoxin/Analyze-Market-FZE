{
  "name": "analyzer-market",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-csp-hash.mjs && tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && tsc --noEmit && npm test && npm run build",
    "ship": "node scripts/ship.mjs",
    "test:unit": "tsx src/data/pricing.test.ts && tsx api/lead.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
